# Public site metadata
NEXT_PUBLIC_SITE_URL=

# Backend
NEXT_PUBLIC_API_BASE_URL=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Media
NEXT_PUBLIC_MEDIA_BASE_URL=

# Instagram
INSTAGRAM_ACCESS_TOKEN=

# Contact forwarding (server-only secrets — never prefix with NEXT_PUBLIC_)
# Create a bot via @BotFather on Telegram, then message it once and read
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel (/admin) — Supabase project URL + anon public key.
# Run supabase/schema.sql in the project's SQL editor first. Only the anon key
# ever belongs here or in client code — never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Publish pipeline (server-only — never prefix with NEXT_PUBLIC_). A fine-grained
# GitHub PAT scoped to this repo only, with "Contents: write" and "Actions: write".
# Triggers .github/workflows/publish.yml, which regenerates src/data/products.json
# from Supabase using its OWN secrets (set in the repo's Settings > Secrets and
# variables > Actions, not here): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_ANON_KEY (the last one is used only by keepalive.yml).
GITHUB_PUBLISH_TOKEN=
GITHUB_REPO=d3zathon/fashionfactory
GITHUB_WORKFLOW_FILE=publish.yml
# MUST match the branch the host actually deploys from — publish.yml regenerates
# and commits src/data/products.json on this ref. Pointing it at a branch the
# site isn't served from means Publish appears to succeed but nothing changes.
GITHUB_PUBLISH_REF=feat/fashion-factory-foundation
