# =============================================================================
# Fashion Factory / multi-store platform — environment variables
# =============================================================================
# Copy to .env.local for development, or paste into the host's environment
# settings (Vercel: Project > Settings > Environment Variables) for production.
#
# NEVER commit real values. .env and .env*.local are gitignored.
#
# Two kinds of variable, and the difference matters:
#
#   NEXT_PUBLIC_*  Inlined into the JavaScript bundle AT BUILD TIME. Visible to
#                  anyone who opens devtools. Changing one requires a redeploy,
#                  not just a restart. Never put a secret here.
#   everything else  Read server-side only (API routes, middleware). Safe for
#                  secrets. Available immediately on the next request.


# -----------------------------------------------------------------------------
# PUBLIC — safe in the browser bundle
# -----------------------------------------------------------------------------

# Absolute origin of this deployment, no trailing slash (https://example.com).
# Drives metadataBase, canonical URLs, robots.txt and sitemap.xml. Without it
# the sitemap renders empty and social previews cannot resolve image URLs.
NEXT_PUBLIC_SITE_URL=

# Which store this deployment serves. Optional: defaults to the store that
# src/data/store.json was generated for. Set it only when pointing a build at a
# different tenant than the committed data (e.g. a preview for a new store).
NEXT_PUBLIC_STORE_SLUG=

# Supabase project URL and anon (publishable) key. Required for /admin to work.
# The anon key is designed to be public — RLS is what protects the data — but
# the service-role key must NEVER appear here or anywhere client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics. The scripts only render when these are set, so leaving them blank
# ships a site with no third-party tracking at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional base URLs, currently unused by any code path — kept as documented
# extension points for a future API/CDN split.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=


# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS — set on the host, never prefixed with NEXT_PUBLIC_
# -----------------------------------------------------------------------------

# Contact form forwarding. When both are set, /api/contact posts inquiries to
# Telegram; when either is missing the endpoint accepts and no-ops, so the form
# never errors on a host that has not configured it yet.
# Create a bot via @BotFather, message it once, then read
# https://api.telegram.org/bot<token>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram Graph API long-lived token. /api/instagram falls back to placeholder
# posts when unset. Tokens expire every 60 days and must be refreshed.
INSTAGRAM_ACCESS_TOKEN=

# Publish pipeline. A fine-grained GitHub PAT scoped to this repository only,
# with "Actions: read and write" and nothing else (fine-grained tokens always
# carry "Metadata: read"). That is the whole permission set the dispatch call
# needs. It does NOT need "Contents: write": the commit and push are made inside
# the workflow by GITHUB_TOKEN, which publish.yml grants `contents: write` for
# that one run. Giving this token Contents access would mean a leak from the web
# host could push arbitrary code to a branch that redeploys itself.
GITHUB_PUBLISH_TOKEN=
GITHUB_REPO=d3zathon/fashionfactory
GITHUB_WORKFLOW_FILE=publish.yml
# MUST match the branch the host actually deploys from. publish.yml commits the
# regenerated data to this ref; pointing it at any other branch makes Publish
# report success while the live site never changes.
GITHUB_PUBLISH_REF=feat/fashion-factory-foundation


# -----------------------------------------------------------------------------
# GITHUB ACTIONS SECRETS — not host env vars
# -----------------------------------------------------------------------------
# These belong in the repository's Settings > Secrets and variables > Actions,
# and are listed here only so the full set is documented in one place. The
# service-role key bypasses RLS entirely: it must never reach the web host or
# any client bundle.
#
#   SUPABASE_URL               same value as NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY  used by scripts/generate-site-data.mjs
#   SUPABASE_ANON_KEY          used only by keepalive.yml


# -----------------------------------------------------------------------------
# DEVELOPMENT
# -----------------------------------------------------------------------------
# The site runs with none of the above set: products, categories and store
# details come from the committed JSON in src/data, the contact form no-ops, the
# Instagram strip shows placeholders, and /admin shows a "not configured" state.
# Set NEXT_PUBLIC_SUPABASE_* locally to work on /admin against a real project.
